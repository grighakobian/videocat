{
  "name": "videocat",
  "version": "0.1.0",
  "description": "A calm desktop video downloader",
  "main": "./out/main/index.js",
  "author": "VideoCat",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "pack:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "pack:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "pack": "npm run build && electron-builder --mac --win --config electron-builder.yml",
    "icon": "node scripts/make-icon.mjs",
    "verify": "node scripts/verify.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
